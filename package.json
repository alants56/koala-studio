{
  "name": "koala-studio",
  "version": "0.1.6",
  "description": "A desktop workspace for collaborating with Claude through ACP.",
  "author": "刘傲的AI实践",
  "license": "CC BY-NC 4.0",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run mcp:build && electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && npm run mcp:build",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.65.0",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-react": "^5.1.1",
    "antd": "^6.5.3",
    "pi-acp": "^0.0.33",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "43.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.alants56.koala-studio",
    "productName": "Koala Studio",
    "icon": "build/icon",
    "asar": false,
    "files": [
      "out/**/*"
    ],
    "mac": {
      "identity": null,
      "target": [
        "dmg"
      ]
    }
  }
}
